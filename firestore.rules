rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSthanDarshan(data) {
      return data.id is string && data.id.size() <= 128
        && data.number is int
        && data.title is string && data.title.size() <= 500
        && data.latitude is number
        && data.longitude is number
        && (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 500))
        && (!('content' in data) || (data.content is string && data.content.size() <= 100000))
        && (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 50000))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000))
        && (!('state' in data) || (data.state is string && data.state.size() <= 200))
        && (!('district' in data) || (data.district is string && data.district.size() <= 200))
        && (!('taluka' in data) || (data.taluka is string && data.taluka.size() <= 200))
        && (!('village' in data) || (data.village is string && data.village.size() <= 200))
        && (!('spiritualImportance' in data) || (data.spiritualImportance is string && data.spiritualImportance.size() <= 50000))
        && (!('history' in data) || (data.history is string && data.history.size() <= 50000))
        && (!('leela' in data) || (data.leela is string && data.leela.size() <= 50000))
        && (!('specialInfo' in data) || (data.specialInfo is string && data.specialInfo.size() <= 50000))
        && (!('architecture' in data) || (data.architecture is string && data.architecture.size() <= 50000))
        && (!('festivals' in data) || (data.festivals is string && data.festivals.size() <= 50000))
        && (!('darshanTiming' in data) || (data.darshanTiming is string && data.darshanTiming.size() <= 2000))
        && (!('contactNumber' in data) || (data.contactNumber is string && data.contactNumber.size() <= 500))
        && (!('website' in data) || (data.website is string && data.website.size() <= 2000))
        && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2000))
        && (!('elevation' in data) || (data.elevation is string && data.elevation.size() <= 500))
        && (!('granthReferences' in data) || (data.granthReferences is list && data.granthReferences.size() <= 100))
        && (!('images' in data) || (data.images is list && data.images.size() <= 100))
        && (!('videos' in data) || (data.videos is list && data.videos.size() <= 100))
        && (!('granthRefs' in data) || (data.granthRefs is list && data.granthRefs.size() <= 100));
    }

    function isValidPlace(data) {
      return data.placeNameMr is string && data.placeNameMr.size() <= 500
        && data.placeNameEn is string && data.placeNameEn.size() <= 500
        && data.latitude is number
        && data.longitude is number
        && (!('state' in data) || (data.state is string && data.state.size() <= 200))
        && (!('district' in data) || (data.district is string && data.district.size() <= 200))
        && (!('taluka' in data) || (data.taluka is string && data.taluka.size() <= 200))
        && (!('village' in data) || (data.village is string && data.village.size() <= 200))
        && (!('category' in data) || (data.category is string && data.category.size() <= 200))
        && (!('history' in data) || (data.history is string && data.history.size() <= 50000))
        && (!('leela' in data) || (data.leela is string && data.leela.size() <= 50000))
        && (!('specialInfo' in data) || (data.specialInfo is string && data.specialInfo.size() <= 50000))
        && (!('status' in data) || (data.status is string && data.status.size() <= 100))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Sthan Darshan collection
    match /sthan_darshan/{sthanId} {
      allow read: if true;
      allow create, update: if isValidId(sthanId) && isValidSthanDarshan(request.resource.data);
      allow delete: if false;
    }

    // Places collection
    match /places/{placeId} {
      allow read: if true;
      allow create, update: if isValidId(placeId) && isValidPlace(request.resource.data);
      allow delete: if isValidId(placeId);
    }

    // Sadhak Contacts collection (Admin added contacts)
    match /sadhak_contacts/{contactId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Niwas items collection (Admin added Niwas in Niwas Kosh)
    match /niwas_items/{niwasId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Community Posts collection
    match /communityPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;

      // Subcollection: Answers
      match /answers/{answerId} {
        allow read, write: if true;

        // Subcollection: Replies
        match /replies/{replyId} {
          allow read, write: if true;
        }

        // Subcollection: Likes on Answer
        match /likes/{userId} {
          allow read, write: if true;
        }
      }

      // Subcollection: Likes on Post
      match /likes/{userId} {
        allow read, write: if true;
      }
    }

    // Community Reports collection
    match /communityReports/{reportId} {
      allow read, write: if true;
    }

    // User profiles & follow system
    match /users/{userId} {
      allow read, write: if true;

      match /followers/{followerId} {
        allow read, write: if true;
      }

      match /following/{followingId} {
        allow read, write: if true;
      }

      match /savedPosts/{postId} {
        allow read, write: if true;
      }

      match /notifications/{notifId} {
        allow read, write: if true;
      }
    }
  }
}
